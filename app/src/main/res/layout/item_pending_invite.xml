<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:textAppearance="@style/TextAppearance.MandaChurras.Heading"
            android:id="@+id/tvCreator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Convite de Fulano"
            android:textColor="@color/mainInk" />

        <TextView
            android:textAppearance="@style/TextAppearance.MandaChurras.Body"
            android:id="@+id/tvDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Data: DD/MM/YYYY Hora: HH:MM"
            android:textColor="@color/mainInk" />

        <TextView
            android:textAppearance="@style/TextAppearance.MandaChurras.Caption"
            android:id="@+id/tvLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Local: Minha casa"
            android:textColor="@color/mainMuted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/details_button" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

