<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mainBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="32dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="78dp"
                android:layout_height="96dp"
                android:contentDescription="@null"
                android:src="@drawable/brand_symbol" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:contentDescription="@string/app_name"
                android:gravity="center"
                android:text="@string/brand_wordmark"
                android:textAppearance="@style/TextAppearance.MandaChurras.Display" />

            <TextView
                android:textAppearance="@style/TextAppearance.MandaChurras.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/app_tagline"
                android:textColor="@color/mainMuted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_login_panel"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:textAppearance="@style/TextAppearance.MandaChurras.Title"
                    android:id="@+id/tvLoginTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/login_credentials_title"
                    android:textColor="@color/mainInk" />

                <TextView
                    android:textAppearance="@style/TextAppearance.MandaChurras.Body"
                    android:id="@+id/tvLoginSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/login_credentials_subtitle"
                    android:textColor="@color/mainMuted" />

                <!-- Etapa 1: e-mail e senha -->
                <LinearLayout
                    android:id="@+id/groupCredentials"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Botão oficial do Google (diretrizes de marca do Google): o caminho mais rápido vem primeiro. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoogle"
                        style="@style/Churrasco.Button.Google"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/login_google" />

                    <TextView
                        android:textAppearance="@style/TextAppearance.MandaChurras.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="@string/login_or"
                        android:textColor="@color/mainMuted" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Churrasco.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/login_email_label">

                        <com.google.android.material.textfield.TextInputEditText
                            android:textAppearance="@style/TextAppearance.MandaChurras.Body"
                            android:id="@+id/edtEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="emailAddress"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:minHeight="56dp"
                            android:textColor="@color/mainInk" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Churrasco.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/login_password_label"
                        app:endIconMode="password_toggle"
                        app:helperText="@string/login_password_helper">

                        <com.google.android.material.textfield.TextInputEditText
                            android:textAppearance="@style/TextAppearance.MandaChurras.Body"
                            android:id="@+id/edtPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="password"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:minHeight="56dp"
                            android:textColor="@color/mainInk" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSignIn"
                        style="@style/Churrasco.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/login_sign_in" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCreateAccount"
                        style="@style/Churrasco.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/login_create_account" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnForgotPassword"
                        style="@style/Churrasco.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/login_forgot_password" />
                </LinearLayout>

                <!-- Etapa 2: confirmar o e-mail -->
                <LinearLayout
                    android:id="@+id/groupVerify"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckVerified"
                        style="@style/Churrasco.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/login_verify_done" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResendVerification"
                        style="@style/Churrasco.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/login_verify_resend" />
                </LinearLayout>

                <!-- Etapa 3: nome no grupo -->
                <LinearLayout
                    android:id="@+id/groupProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Churrasco.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:hint="@string/login_field_label"
                        app:boxBackgroundColor="@color/mainBackground"
                        app:counterEnabled="true"
                        app:counterMaxLength="60">

                        <com.google.android.material.textfield.TextInputEditText
                            android:textAppearance="@style/TextAppearance.MandaChurras.Body"
                            android:id="@+id/edtUserName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLength="60"
                            android:maxLines="1"
                            android:minHeight="56dp"
                            android:textColor="@color/mainInk" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveProfile"
                        style="@style/Churrasco.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/login_button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLegacyAccount"
                        style="@style/Churrasco.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/login_legacy_button"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Etapa 3b: pedido de conta antiga em análise -->
                <LinearLayout
                    android:id="@+id/groupWaiting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefreshStatus"
                        style="@style/Churrasco.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/login_waiting_refresh" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUseAnotherAccount"
                    style="@style/Churrasco.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/login_use_another_account"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/connectionStateOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mainBackground"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:textAppearance="@style/TextAppearance.MandaChurras.Title"
                android:id="@+id/txtConnectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/connection_state_title"
                android:textColor="@color/mainInk" />

            <TextView
                android:textAppearance="@style/TextAppearance.MandaChurras.Body"
                android:id="@+id/txtConnectionMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/connection_state_message"
                android:textColor="@color/mainInk" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryConnection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/connection_state_retry" />

        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center" />
    </FrameLayout>

</FrameLayout>
