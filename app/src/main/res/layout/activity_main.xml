<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mainBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="28dp"
            android:paddingEnd="16dp"
            android:paddingBottom="120dp">
            <!-- 120dp = 32dp de respiro + espaço da barra de navegação de baixo -->

            <TextView
                android:textAppearance="@style/TextAppearance.MandaChurras.Title"
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_title"
                android:textColor="@color/mainInk" />

            <TextView
                android:textAppearance="@style/TextAppearance.MandaChurras.Body"
                android:id="@+id/txtGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ola_usuario"
                android:textColor="@color/mainMuted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_main_header"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:textAppearance="@style/TextAppearance.MandaChurras.Heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/main_welcome_title"
                    android:textColor="@color/mainInk" />

                <TextView
                    android:textAppearance="@style/TextAppearance.MandaChurras.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/main_welcome_body"
                    android:textColor="@color/mainMuted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateChurrasco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/main_primary_action" />
            </LinearLayout>

            <TextView
                android:textAppearance="@style/TextAppearance.MandaChurras.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/main_dashboard_title"
                android:textColor="@color/mainInk" />

            <TextView
                android:textAppearance="@style/TextAppearance.MandaChurras.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/main_dashboard_body"
                android:textColor="@color/mainMuted" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnPendingInvites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:textAppearance="@style/TextAppearance.MandaChurras.Heading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/main_card_invites_title"
                            android:textColor="@color/mainInk" />

                        <TextView
                            android:textAppearance="@style/TextAppearance.MandaChurras.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/main_card_invites_body"
                            android:textColor="@color/mainMuted" />
                    </LinearLayout>

                    <TextView
                        android:textAppearance="@style/TextAppearance.MandaChurras.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/main_card_open"
                        android:textColor="@color/mainPrimaryDark" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnActiveChurrascos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:textAppearance="@style/TextAppearance.MandaChurras.Heading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/main_card_active_title"
                            android:textColor="@color/mainInk" />

                        <TextView
                            android:textAppearance="@style/TextAppearance.MandaChurras.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/main_card_active_body"
                            android:textColor="@color/mainMuted" />
                    </LinearLayout>

                    <TextView
                        android:textAppearance="@style/TextAppearance.MandaChurras.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/main_card_open"
                        android:textColor="@color/mainPrimaryDark" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnPastChurrascos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:textAppearance="@style/TextAppearance.MandaChurras.Heading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/main_card_history_title"
                            android:textColor="@color/mainInk" />

                        <TextView
                            android:textAppearance="@style/TextAppearance.MandaChurras.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/main_card_history_body"
                            android:textColor="@color/mainMuted" />
                    </LinearLayout>

                    <TextView
                        android:textAppearance="@style/TextAppearance.MandaChurras.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/main_card_open"
                        android:textColor="@color/mainPrimaryDark" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:textAppearance="@style/TextAppearance.MandaChurras.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/main_section_account"
                android:textColor="@color/mainInk" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFriends"
                style="@style/Churrasco.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/main_friends" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfile"
                style="@style/Churrasco.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/main_profile" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReviewLegacyMain"
                style="@style/Churrasco.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/legacy_review_accounts"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSwitchUser"
                style="@style/Churrasco.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/trocar_usuario"
                android:textColor="@color/mainMuted" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_navigation" />

    <FrameLayout
        android:id="@+id/connectionStateOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mainBackground"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:textAppearance="@style/TextAppearance.MandaChurras.Title"
                android:id="@+id/txtConnectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/connection_state_title"
                android:textColor="@color/mainInk" />

            <TextView
                android:textAppearance="@style/TextAppearance.MandaChurras.Body"
                android:id="@+id/txtConnectionMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/connection_state_message"
                android:textColor="@color/mainInk" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryConnection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/connection_state_retry" />

        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center" />
    </FrameLayout>

</FrameLayout>

