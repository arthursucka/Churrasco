{
  "rules": {
    ".read": false,
    ".write": false,
    "churrascos": {
      "$churrascoId": {
        "messages": {
          ".read": "auth != null && root.child('eventAccess').child($churrascoId).child(auth.uid).val() === true",
          ".write": false
        },
        "locations": {
          ".read": "auth != null && root.child('eventAccess').child($churrascoId).child(auth.uid).val() === true",
          ".write": false
        }
      }
    },
    "eventAccess": {
      ".read": false,
      ".write": false
    }
  }
}
